# ============================================================
#  RM e-HotelManager — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ──────────────────────────────────────────────────────────
# PostgreSQL Database
# ──────────────────────────────────────────────────────────
POSTGRES_DB=hoteldb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full connection string used by the backend service
# Local dev:
DATABASE_URL=postgresql://postgres:postgres@hotel-db:5432/hoteldb
# Production example (use a strong password and dedicated user):
# DATABASE_URL=postgresql://hotel_user:strong-password@hotel-db:5432/hoteldb

# ──────────────────────────────────────────────────────────
# Backend API
# ──────────────────────────────────────────────────────────

# Secret key required by admin-only routes (change in production!)
ADMIN_API_KEY=dev-admin-key

# Runtime environment: development | production
ENV=development

# Default rate calculation source mode: hybrid | calculated | excel
DEFAULT_RATE_SOURCE_MODE=hybrid

# Server port (defaults to 8000 if unset)
PORT=8000

# ──────────────────────────────────────────────────────────
# CORS — Allowed Frontend Origins
# ──────────────────────────────────────────────────────────

# Local development
USER_WEB_ORIGIN=http://localhost:5174
ADMIN_WEB_ORIGIN=http://localhost:5173

# Production
# USER_WEB_ORIGIN=https://hotel.hotelmanager.fr
# ADMIN_WEB_ORIGIN=https://admin.hotelmanager.fr

# ──────────────────────────────────────────────────────────
# Frontend Build Argument (baked in at Docker build time)
# ──────────────────────────────────────────────────────────

# Local development (used in docker-compose.yml)
VITE_API_URL=http://localhost:8000

# Production (used in docker-compose.prod.yml — overridden per-service)
# VITE_API_URL=https://api.hotelmanager.fr
